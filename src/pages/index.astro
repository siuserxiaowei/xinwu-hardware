---
import { withBase } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Catalog from '../components/Catalog.astro';
---
<Layout active="home">
<div class="container">
  <section class="intro"><div><div class="eyebrow"><span class="tiny-dot"></span> A FIELD GUIDE TO AI HARDWARE</div><h1>发现，有意思的 <span>AI 硬件。</span></h1><p>看得见的新科技，用得上的新生活。一起探索国内外的有趣硬件。</p></div><a href={withBase('/about/')} class="intro-note"><span>保持好奇<br/>从新物开始</span><img class="intro-brand-mark" src={withBase('/favicon.svg')} width="38" height="38" alt=""/></a></section>
  <section class="featured" aria-label="编辑精选">
    <a class="feature feature-main" href={withBase('/products/even-g1/')}><div class="feature-top"><span class="pill">新物精选 · 智能眼镜</span><span class="mono">产品介绍</span></div><div class="feature-watermark" aria-hidden="true">A NEW PERSPECTIVE</div><img class="hero-product" src={withBase('/images/even-product.webp')} width="1600" height="614" alt="Even G1 智能眼镜官方产品图" fetchpriority="high"/><div class="feature-bottom"><div><span class="eyebrow">EVEN REALITIES / G1</span><h2>让信息，轻轻出现在眼前。</h2><p>一副眼镜，和少一点低头的可能。</p></div><span class="feature-cta">查看产品</span></div></a>
    <a class="feature feature-side" href={withBase('/products/rabbit-r1/')}><div class="feature-top"><span class="pill">另一种 AI 交互</span></div><img src={withBase('/images/rabbit-scene.webp')} width="1600" height="2000" alt="手持 rabbit r1 的官方场景图" fetchpriority="high"/><div class="feature-bottom"><div><span class="eyebrow">RABBIT / R1</span><h2>AI，也可以握在手里。</h2><p><span class="feature-inline-link">查看产品介绍</span></p></div></div></a>
  </section>
  <section class="discovery-heading"><div><span class="eyebrow">THE DISCOVERY INDEX</span><h2>下一件新物，从这里发现。</h2></div><a class="text-link" href={withBase('/products/')}>探索全部硬件</a></section>
  <Catalog/>
  <section class="editorial-strip"><div><span class="eyebrow">A LITTLE INSPIRATION</span><h2>先有一个生活场景，<br/>再找一件合适的硬件。</h2><a class="text-link" href={withBase('/collections/')}>看看灵感专题</a></div><a href={withBase('/collections/#work')}><span>01 / 工作与灵感</span><h3>把精力留给交流，<br/>把记录交给工具。</h3><span class="topic-cta">浏览专题</span></a><a href={withBase('/collections/#companion')}><span>02 / 日常与陪伴</span><h3>如果桌面上，<br/>多了一个小伙伴。</h3><span class="topic-cta">浏览专题</span></a></section>
  <section class="partner-banner"><div><span class="eyebrow">FOR THE MAKERS</span><h2>你在创造新硬件，我们帮更多人看见。</h2><p>产品收录 · 图文介绍 · 自媒体内容合作</p></div><a class="button light" href={withBase('/partners/')}><Icon name="partner" size={19}/>了解合作方式</a></section>
</div>
</Layout>
