---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import {products} from '../data/products';
const collections=[{id:'work',label:'01 / WORK & IDEAS',title:'把精力留给交流。',description:'会议、访谈与随手记下的想法。先了解设备怎样采集声音，再关注软件如何整理，以及还需要多少人工校对。',slugs:['plaud-note','plaud-notepin']},{id:'companion',label:'02 / LIFE & COMPANY',title:'给生活，多一点回应。',description:'桌面或客厅里的电子小伙伴。除了第一眼的可爱，也值得看看互动方式、活动空间和长期使用的新鲜感。',slugs:['emo','loona']},{id:'wear',label:'03 / BEYOND THE SCREEN',title:'屏幕之外，还有新可能。',description:'把信息带到眼前，或者交给一个随身设备。用同一个问题审视它们：它有没有让常用任务更方便？',slugs:['even-g1','rabbit-r1']}];
---
<Layout active="collections" title="灵感专题 · 新物"><div class="container"><section class="page-heading"><span class="eyebrow">A LITTLE INSPIRATION</span><h1>从生活出发，遇见新物。</h1><p>每个专题，都是一种认识硬件的方式。</p></section>{collections.map(c=><section class="collection-section" id={c.id}><div class="collection-description"><span class="eyebrow">{c.label}</span><h2>{c.title}</h2><p>{c.description}</p><span class="small-muted">产品探索专题 · 非购买排名</span></div><div class="collection-products">{products.filter(p=>c.slugs.includes(p.slug)).map(p=><ProductCard product={p}/>)}</div></section>)}</div></Layout>
