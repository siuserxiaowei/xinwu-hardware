---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="提交产品 · 新物"><div class="container submit-layout"><div class="submit-intro"><span class="eyebrow">SOMETHING NEW?</span><h1>下一件新物，<br/>也许来自你。</h1><p>我们关注能走进生活的 AI 硬件。<br/>欢迎提供产品资料，或整理你的合作想法。</p><div class="notice">预览版暂未接入收件服务。此处只保存本机草稿，也可以导出文件，不会向网站或品牌发送信息。</div></div><form id="product-form" class="product-form"><label>你希望做什么<select name="type"><option>产品收录</option><option>合作咨询</option></select></label><label>产品 / 品牌名称 <span>*</span><input name="product" required maxlength="100" placeholder="例如：新物智能眼镜"/></label><label>产品官网 <span>*</span><input type="url" name="website" required placeholder="https://"/></label><label>联系邮箱 <span>*</span><input type="email" name="email" required placeholder="方便后续联系的邮箱"/></label><label>简单介绍一下 <span>*</span><textarea name="description" required maxlength="3000" rows="5" placeholder="产品解决什么问题？你希望我们重点了解什么？"></textarea></label><div class="form-actions"><button type="submit" class="button">保存本机草稿 <Icon name="check" size={18}/></button><button type="button" id="export-draft" class="text-link">导出资料 ↗</button><button type="button" id="clear-draft" class="text-link">清除草稿</button></div><p id="form-status" role="status" aria-live="polite"></p></form></div></Layout>
<script>
  const form=document.querySelector<HTMLFormElement>('#product-form')!;
  const status=document.querySelector<HTMLElement>('#form-status')!;
  const key='xinwu-product-draft-v1';
  try{const raw=localStorage.getItem(key);if(raw){const draft=JSON.parse(raw);for(const [k,v]of Object.entries(draft)){const el=form.elements.namedItem(k);if(el instanceof HTMLInputElement||el instanceof HTMLTextAreaElement||el instanceof HTMLSelectElement)el.value=String(v);}status.textContent='已恢复本机保存的草稿。';}}catch{status.textContent='无法读取本机草稿，你仍可填写并导出资料。';}
  if(new URLSearchParams(location.search).get('type')==='合作咨询')(form.elements.namedItem('type') as HTMLSelectElement).value='合作咨询';
  form.addEventListener('submit',e=>{e.preventDefault();try{localStorage.setItem(key,JSON.stringify(Object.fromEntries(new FormData(form))));status.textContent='草稿已保存在此浏览器，尚未发送。';}catch{status.textContent='浏览器无法保存草稿，请使用“导出资料”。';}});
  document.querySelector('#export-draft')?.addEventListener('click',()=>{if(!form.reportValidity())return;const content=JSON.stringify(Object.fromEntries(new FormData(form)),null,2);const url=URL.createObjectURL(new Blob([content],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='新物-产品与合作资料.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),500);status.textContent='资料已导出，尚未发送。';});
  document.querySelector('#clear-draft')?.addEventListener('click',()=>{try{localStorage.removeItem(key);form.reset();status.textContent='本机草稿已清除。';}catch{status.textContent='无法清除浏览器存储，请检查浏览器权限。';}});
</script>
