---
import {withBase} from '../lib/urls';
const options = [
  {id:'A',name:'机物工坊',tag:'金属 · 实体质感',description:'银白机身与橙色切角，像一组精密的小硬件。'},
  {id:'B',name:'新物印记',tag:'平面 · 鲜明轮廓',description:'黑白形状与橙色断点，突出简洁的品牌识别。'},
  {id:'C',name:'琥珀标本',tag:'通透 · 收藏感',description:'琥珀色透明外壳与光学细节，像一组小型收藏品。'},
  {id:'D',name:'光层徽章',tag:'分层 · App 图标',description:'深蓝底板、明亮主体与橙色焦点，形成紧凑的图标画面。'},
  {id:'E',name:'新物贴纸',tag:'插画 · 贴纸感',description:'白色裁切边与橙色翻角，把硬件画成可收集的贴纸。'},
  {id:'F',name:'口袋展馆',tag:'空间 · 微缩展台',description:'每个类别拥有一个小展位，统一视角与空间结构。'},
  {id:'G',name:'新物伙伴',tag:'手绘 · 亲近感',description:'不规则墨线与有性格的硬件形象，轻松而有温度。'},
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
    <meta name="robots" content="noindex,nofollow"/>
    <title>新物 · 图标方向选稿</title>
    <meta name="description" content="一起选一套属于新物的图标。查看 A—G 七个视觉方向，放大比较，分享你的选择。"/>
    <link rel="icon" href={withBase('/favicon.svg')}/>
  </head>
  <body>
    <a class="skip" href="#options">跳到方案</a>
    <header class="masthead"><a href={withBase('/')} aria-label="前往新物硬件首页"><img src={withBase('/favicon.svg')} alt="" width="28" height="28"/><strong>新物</strong></a><span>视觉提案 / 选稿专页</span></header>
    <main>
      <section class="intro"><div class="kicker">XINWU · ICON EXPLORATIONS</div><h1>哪一套，最像新物？</h1><p>七个方向，同样的五类硬件。先看整体感觉，再放大看细节。</p><p class="muted">这些是视觉概念稿，选定后再打磨细节与小尺寸效果。</p><nav aria-label="跳到具体方案">{options.map(o=><a href={`#option-${o.id}`}><b>{o.id}</b>{o.name}</a>)}</nav></section>
      <section id="options" class="gallery" aria-label="七套图标方案">
        {options.map((o,i)=><article id={`option-${o.id}`} class="proposal">
          <div class="card-top"><div class="title"><span class="letter">{o.id}</span><h2>{o.name}</h2></div><span class="tag">{o.tag}</span></div>
          <a class="art" href={withBase(`/icon-proposals/${o.id.toLowerCase()}.webp`)} data-preview data-name={`${o.id} · ${o.name}`} aria-label={`放大查看 ${o.id} ${o.name}`}><img src={withBase(`/icon-proposals/${o.id.toLowerCase()}.webp`)} width="1536" height="1024" loading={i<2?'eager':'lazy'} alt={`${o.id} ${o.name}：全部硬件、智能眼镜、录音与效率、陪伴机器人及随身 AI 图标概念`}/><span class="enlarge">放大查看</span></a>
          <div class="card-bottom"><p>{o.description}</p><label class="pick"><input type="checkbox" value={`${o.id} · ${o.name}`} aria-label={`喜欢 ${o.id} ${o.name}`}/><span>喜欢这版</span></label></div>
        </article>)}
      </section>
      <section class="feedback" aria-labelledby="feedback-title"><div><div class="kicker">YOUR PICK</div><h2 id="feedback-title">把你的选择，带回讨论。</h2><p>可以选一版，也可以组合喜欢的特点。比如：“D 的层次＋E 的轮廓”。</p></div><div class="feedback-form"><label for="notes">想保留或调整的地方 <span>（选填）</span></label><textarea id="notes" rows="3" placeholder="例如：喜欢 E 的贴纸感，希望颜色再克制一点。"></textarea><button id="copy" type="button">复制我的选择</button><p id="status" role="status" aria-live="polite">勾选喜欢的方案后，复制文字发给伙伴。</p><textarea id="copy-fallback" aria-label="选择结果，请全选复制" readonly hidden></textarea></div></section>
      <footer>新物 · 图标方向提案 <span>A—G / 7 个方向</span></footer>
    </main>
    <div class="selection-bar" hidden><span id="selection-summary" aria-live="polite"></span><a href="#feedback-title">整理我的选择</a></div>
    <dialog id="preview" aria-labelledby="preview-title"><div class="preview-header"><h2 id="preview-title"></h2><button id="close-preview" type="button" autofocus>关闭大图</button></div><div class="preview-image"><img id="preview-image" alt=""/></div><a id="original" target="_blank" rel="noopener noreferrer">打开原图</a></dialog>
    <noscript><p class="noscript">点击图片可以打开大图。你也可以直接把喜欢的方案编号发给伙伴。</p></noscript>
    <script>
      const modal=document.querySelector<HTMLDialogElement>('#preview')!;
      const image=document.querySelector<HTMLImageElement>('#preview-image')!;
      const original=document.querySelector<HTMLAnchorElement>('#original')!;
      document.querySelectorAll<HTMLAnchorElement>('[data-preview]').forEach(link=>link.addEventListener('click',event=>{
        event.preventDefault();image.src=link.href;image.alt=link.dataset.name+' 图标概念';original.href=link.href;
        document.querySelector('#preview-title')!.textContent=link.dataset.name||'';modal.showModal();document.body.style.overflow='hidden';
      }));
      document.querySelector('#close-preview')!.addEventListener('click',()=>modal.close());
      modal.addEventListener('close',()=>document.body.style.overflow='');
      modal.addEventListener('click',event=>{if(event.target===modal){const rect=modal.getBoundingClientRect();if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)modal.close();}});
      const checks=[...document.querySelectorAll<HTMLInputElement>('.pick input')];
      const chosen=()=>checks.filter(c=>c.checked).map(c=>c.value);
      const bar=document.querySelector<HTMLElement>('.selection-bar')!;
      checks.forEach(input=>input.addEventListener('change',()=>{
        input.closest('.proposal')?.classList.toggle('chosen',input.checked);
        const selected=chosen();bar.hidden=selected.length===0;
        document.querySelector('#selection-summary')!.textContent='已选 '+selected.map(s=>s[0]).join('、');
        document.querySelector<HTMLTextAreaElement>('#copy-fallback')!.hidden=true;
      }));
      document.querySelector('#copy')!.addEventListener('click',async()=>{
        const selected=chosen();const status=document.querySelector('#status')!;
        if(!selected.length){status.textContent='先勾选至少一套你喜欢的方案。';return;}
        const notes=document.querySelector<HTMLTextAreaElement>('#notes')!.value.trim();
        const text='新物图标选稿\n我的选择：'+selected.join('、')+(notes?'\n想法：'+notes:'')+'\n方案链接：'+new URL(location.pathname,location.origin).href;
        try{await navigator.clipboard.writeText(text);status.textContent='已复制，可以粘贴到聊天里分享。';}
        catch{const fallback=document.querySelector<HTMLTextAreaElement>('#copy-fallback')!;fallback.value=text;fallback.hidden=false;fallback.focus();fallback.select();status.textContent='请复制下面的选择结果，发到聊天里。';}
      });
    </script>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth;scroll-padding-top:24px} :global(body){margin:0;background:#faf9f6;color:#242623;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif} :global(a){color:inherit;text-decoration:none} :global(button),:global(input),:global(textarea){font:inherit} :global(button),:global(a),:global(input){-webkit-tap-highlight-color:transparent} :global(:focus-visible){outline:3px solid #d75431;outline-offset:4px} :global([hidden]){display:none!important}
  .masthead,main{max-width:1240px;width:calc(100% - 64px);margin:auto}.masthead{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e0dfd6}.masthead>a{display:flex;gap:10px;align-items:center}.masthead strong{font-size:24px}.masthead>span{font-size:12px;color:#787b72}.skip{position:fixed;left:10px;top:-80px;padding:12px;background:white;z-index:10}.skip:focus{top:10px}.intro{padding:58px 0 38px}.kicker{font-size:10px;letter-spacing:2px;color:#bd512f}.intro h1{font-size:clamp(32px,4vw,48px);font-weight:600;letter-spacing:-1.5px;margin:18px 0}.intro p{font-size:14px;line-height:1.9;margin:7px 0;color:#5c6257}.intro p.muted{font-size:12px;color:#85887f}.intro nav{display:flex;gap:9px;flex-wrap:wrap;margin-top:25px}.intro nav a{display:flex;gap:9px;align-items:center;border:1px solid #dedfd5;border-radius:8px;padding:10px 13px;font-size:12px;background:#fffdf8}.intro nav b{color:#ca522e;font-size:13px}.intro nav a:hover{background:#f1ede3}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:25px}.proposal{min-width:0;border:1px solid #dfdfd5;border-radius:15px;overflow:hidden;background:#fffdfa;transition:border-color .15s}.proposal.chosen{border-color:#cd5836;box-shadow:0 0 0 1px #cd5836}.card-top{display:flex;justify-content:space-between;align-items:center;padding:20px 22px;gap:10px}.title{display:flex;align-items:center;gap:11px}.letter{display:grid;place-items:center;width:29px;height:29px;background:#eeeee6;border-radius:7px;font-size:13px;font-weight:600}.title h2{font-size:19px;margin:0;font-weight:500}.tag{font-size:10px;color:#777b71}.art{display:block;position:relative;background:#faf9f6}.art img{display:block;width:100%;height:auto}.enlarge{position:absolute;right:14px;bottom:13px;padding:7px 10px;background:#252923e8;color:#fff;border-radius:6px;font-size:10px}.art:hover .enlarge{background:#c45130}.card-bottom{padding:18px 22px;display:flex;align-items:center;gap:16px;justify-content:space-between}.card-bottom p{font-size:12px;line-height:1.8;color:#6c7266;margin:0;max-width:340px}.pick{display:flex;gap:7px;align-items:center;white-space:nowrap;min-height:44px;cursor:pointer;font-size:12px}.pick input{width:18px;height:18px;accent-color:#d75a36}.feedback{display:grid;grid-template-columns:1fr 1fr;gap:60px;padding:45px 0;margin-top:48px;border-top:1px solid #deded4}.feedback h2{font-size:27px;font-weight:500;line-height:1.5;margin:14px 0}.feedback p{font-size:12px;line-height:1.9;color:#757b6e}.feedback-form>label{font-size:13px;display:block;margin-bottom:12px}.feedback-form label span{color:#888}.feedback textarea{display:block;resize:vertical;width:100%;background:#fffdfa;border:1px solid #d5d7ca;padding:14px;border-radius:9px;font-size:13px;line-height:1.8}.feedback button{border:0;background:#293027;color:#fff;padding:13px 23px;border-radius:8px;font-size:13px;cursor:pointer;margin-top:16px;min-height:44px}.feedback button:hover{background:#43503e}#status{min-height:24px;margin-bottom:0}.selection-bar{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#283127;color:white;border:1px solid #65725b;box-shadow:0 8px 35px #14291020;display:flex;gap:25px;align-items:center;border-radius:12px;padding:15px 20px;max-width:calc(100% - 30px);z-index:2;font-size:12px}.selection-bar a{color:#f4b38e;text-decoration:underline;text-underline-offset:4px;white-space:nowrap}.selection-bar span{white-space:nowrap}footer{display:flex;justify-content:space-between;gap:20px;color:#808478;font-size:11px;padding:25px 0 110px;border-top:1px solid #e0dfd6}footer span{font-size:10px}dialog{border:1px solid #dedfd6;border-radius:14px;padding:16px;background:#faf9f6;width:min(1400px,96vw);max-height:94dvh;color:#242623}dialog::backdrop{background:#171d17d9}.preview-header{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:0 0 12px}.preview-header h2{font-size:16px;margin:0;font-weight:500}.preview-header button{padding:11px 15px;border:1px solid #d9dcce;border-radius:7px;background:#fffdfa;cursor:pointer;font-size:12px}.preview-image{overflow:auto}.preview-image img{display:block;width:100%;height:auto}#original{display:inline-block;font-size:12px;text-decoration:underline;text-underline-offset:3px;margin-top:12px}.noscript{padding:20px;text-align:center;font-size:12px}
  @media(max-width:800px){.card-top{padding:17px}.title h2{font-size:17px}.tag{font-size:9px}.card-bottom{padding:12px 17px;display:block}.pick{margin-top:5px}.feedback{gap:30px}.feedback h2{font-size:23px}.gallery{gap:17px}}
  @media(max-width:600px){.masthead,main{width:calc(100% - 32px)}.masthead{height:68px}.masthead strong{font-size:22px}.masthead>span{font-size:10px}.intro{padding:35px 0 26px}.intro h1{font-size:33px}.intro p{font-size:12px}.intro nav{gap:7px;margin-top:22px}.intro nav a{font-size:10px;padding:9px 10px}.gallery{grid-template-columns:1fr;gap:21px}.card-top{padding:16px}.title h2{font-size:19px}.tag{font-size:10px}.card-bottom{padding:14px 16px;display:flex}.card-bottom p{font-size:11px}.pick{font-size:11px;margin:0;gap:5px}.feedback{grid-template-columns:1fr;gap:20px;margin-top:30px;padding:30px 0}.feedback h2{font-size:26px}.feedback p{font-size:12px}.selection-bar{gap:16px;padding:13px 15px;font-size:11px}.selection-bar span{white-space:normal}dialog{padding:10px;border-radius:10px}.preview-header h2{font-size:14px}.preview-image img{min-width:800px}.preview-image{max-height:65dvh}.preview-header button{font-size:11px}.enlarge{font-size:9px;padding:6px 8px}footer{font-size:10px}footer span{font-size:9px}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.proposal{transition:none}}
</style>
