---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../ProductCard.astro';
import Icon from '../Icon.astro';
import GuideFigure from './GuideFigure.astro';
import { products, type Product } from '../../data/products';
import type { Guide } from '../../data/product-guides';
import { withBase } from '../../lib/urls';
import '../../styles/product-guide.css';
interface Props { product: Product; guide: Guide; }
const { product: p, guide: g } = Astro.props;
const related = products.filter(x => x.slug !== p.slug && x.categoryId === p.categoryId).slice(0, 3);
---
<Layout title={`${g.title} · 新物`} description={g.deck} active="products">
  <div class="container guide-page">
    <nav class="breadcrumbs" aria-label="面包屑"><a href={withBase('/')}>发现</a><span>/</span><a href={withBase('/products/?category=robots')}>陪伴硬件</a><span>/</span><span>{p.name}</span></nav>
    <header class="guide-header">
      <span class="eyebrow">XINWU FIELD NOTES / 产品详解</span>
      <h1>{g.title}</h1><p class="guide-deck">{g.deck}</p>
      <div class="guide-byline"><span>新物编辑部</span><time datetime="2026-09-19">2026.09.19</time><span class="guide-status"><span class="tiny-dot"></span>资料解读 · 尚未实测</span></div>
    </header>
    <div class="guide-opening">
      <GuideFigure {...g.image} hero/>
      <aside class="guide-facts" aria-label="产品速览"><span class="eyebrow">AT A GLANCE</span><h2>先认识它</h2><dl>{p.facts.map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}</dl><a href="#guide-sources" class="text-link">查看资料依据</a></aside>
    </div>
    <div class="guide-reading">
      <aside class="guide-toc"><nav aria-label="文章目录"><span class="eyebrow">阅读目录</span><ol>{g.toc.map(([id, label], i) => <li><a href={`#${id}`}><span>0{i+1}</span>{label}</a></li>)}</ol><a href="#guide-sources">资料与图片来源</a></nav></aside>
      <article class="guide-prose" aria-label={`${p.name}详细介绍`}>
        <p class="guide-editor-note">本文依据公开产品资料和注明来源的报道整理，图片为产品资料图。文中的场景建议与判断来自编辑分析，尚不包含新物的上手测试结果。</p>
        <slot/>
        <section id="video-links" class="guide-video"><span class="eyebrow">WATCH ELSEWHERE</span><h2>想看动态演示？</h2><p>新物自制视频尚未发布。你可以先前往公域平台搜索相关介绍；视频中的品牌、型号和软件版本，请与本文对照。</p><div class="video-links">
          <a href={`https://search.bilibili.com/all?keyword=${encodeURIComponent(p.name+' 测评')}`} target="_blank" rel="noopener noreferrer"><span class="platform-name bili">B站</span><span><strong>搜索相关测评</strong><small>外部搜索 · 非新物自制视频</small></span><Icon name="external" size={18}/></a>
          <a href={`https://www.xiaohongshu.com/search_result?keyword=${encodeURIComponent(p.name)}`} target="_blank" rel="noopener noreferrer"><span class="platform-name red">小红书</span><span><strong>查看使用分享</strong><small>外部搜索 · 部分内容需登录</small></span><Icon name="external" size={18}/></a>
        </div></section>
        <section id="guide-sources" class="guide-sources"><span class="eyebrow">SOURCES & NOTES</span><h2>资料与图片来源</h2><ol>{g.sources.map((source, i) => <li id={`source-${i+1}`}><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} <Icon name="external" size={14}/></a><p>{source.note}</p></li>)}</ol><p class="guide-update">资料整理：2026 年 9 月 19 日。价格、配套软件与服务会变化；后续实测会单独标明样机、版本及测试条件。</p></section>
      </article>
    </div>
    <section class="related"><div class="section-title"><div><span class="eyebrow">KEEP EXPLORING</span><h2>再认识一个小伙伴。</h2></div><a class="text-link" href={withBase('/products/')}>全部硬件</a></div><div class="product-grid">{related.map(product => <ProductCard product={product}/>)}</div></section>
  </div>
</Layout>
